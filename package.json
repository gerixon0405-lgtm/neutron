{
  "name": "neutron",
  "productName": "Neutron",
  "version": "1.1.0",
  "description": "Neutron AI-munkat\u00e9r",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "electron-updater": "6.8.11"
  },
  "author": "gerixon0405-lgtm",
  "repository": "https://github.com/gerixon0405-lgtm/neutron.git",
  "build": {
    "appId": "io.github.gerixon0405.neutron",
    "asar": false,
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.png",
      "*.py",
      "!test_*.py",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gerixon0405-lgtm",
        "repo": "neutron"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "Neutron-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/python",
          "to": "python"
        }
      ],
      "artifactName": "Neutron-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
